APP_NAME=SmartCampus AI
ENV=dev
# PostgreSQL (docker compose up -d db, port publié 5432). Dans Docker, compose remplace l'hôte par "db".
DATABASE_URL=postgresql+psycopg://smartcampus:0000@localhost:5432/smartcampus_v2
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
EMBEDDING_DIM=768
# Dev: cr?e admin@/iit@/isb@/entretien@/direction@smartcampus.tn avec ce mot de passe
SEED_TEAM_PASSWORD=


# Mémoire de session (mémoire de travail temporaire de l'agent) : limites et expiration
SESSION_TTL_MINUTES=30
SESSION_MAX_AGE_MINUTES=240
SESSION_MAX_TURNS=6
SESSION_MAX_CHARS=300
SESSION_MAX_BYTES=8192
SESSION_PURGE_INTERVAL_SECONDS=300


# LLM optionnel : modèle dérija EXISTANT, sans fine-tuning (endpoint compatible OpenAI : vLLM, Ollama...)
# Cloud (ex. Hugging Face Inference Endpoints, déploiement du dépôt ESPRIT-Group/ESPRIT-Derja-Qwen3-8B-v2 avec vLLM) :
#   LLM_BASE_URL = URL de l'endpoint terminée par /v1, LLM_API_KEY = jeton Hugging Face (hf_...)
# Local : docker compose --profile llm up -d (GPU NVIDIA requis), puis LLM_BASE_URL=https://REMPLACER.endpoints.huggingface.cloud/v1
LLM_ENABLED=true
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=ESPRIT-Group/ESPRIT-Derja-Qwen3-8B-v2
LLM_API_KEY=
# Endpoint cloud en veille : prévoir un délai plus long au premier appel (démarrage à froid)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.3
LLM_LANGUAGES=tn,arabizi

APP_NAME=SmartCampus AI
ENV=dev
# Local, no install: a single SQLite file (the RAG vector table is skipped).
DATABASE_URL=sqlite:///./smartcampus.db
# PostgreSQL + pgvector (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5432/smartcampus
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
EMBEDDING_DIM=768
